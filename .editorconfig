root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# Immutable reviewed source snapshots
[docs/reference/planning/**]
charset = unset
end_of_line = unset
insert_final_newline = unset

[docs/stages/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
