{
  "cli": {
    "version": "27.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "node": "24.15.0",
      "pnpm": "11.25.0"
    }
  }
}
