{
  "name": "@judoju/news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "check:foundation": "node scripts/verify-foundation.mjs",
    "check:toolchain": "node scripts/verify-toolchain.mjs",
    "dev:mobile": "corepack pnpm --filter @judoju/mobile dev",
    "dev:admin": "corepack pnpm --filter @judoju/admin dev",
    "check:types": "corepack pnpm -r --if-present check",
    "build:admin": "corepack pnpm --filter @judoju/admin build",
    "export:android": "corepack pnpm --filter @judoju/mobile export:android",
    "export:ios": "corepack pnpm --filter @judoju/mobile export:ios",
    "test:domain": "node --experimental-strip-types --test tests/domain.test.ts tests/native-release.test.mjs",
    "eas": "node scripts/eas.mjs",
    "test:providers": "node --test tests/providers.test.mjs",
    "check:providers": "node scripts/verify-stage3-providers.mjs",
    "test:m0-contracts": "node --experimental-strip-types --test tests/market-context.test.ts tests/local-bootstrap.test.mjs",
    "test:m0-runtime": "node scripts/test-m0-runtime.mjs && node scripts/test-m0-publication.mjs",
    "test:m1-contracts": "node --test tests/public-read-gateway.test.mjs tests/editor-state.test.mjs",
    "test:m1-runtime": "node scripts/test-m1-auth.mjs && node scripts/test-m1-publication.mjs && node scripts/test-m1-http.mjs"
  },
  "devDependencies": {
    "supabase": "3.1.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "smol-toml": "1.9.1"
  }
}
