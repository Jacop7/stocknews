{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm -s run check:types)",
      "Bash(pnpm run check:types)",
      "Bash(pnpm dev:read)",
      "Bash(pnpm test:dev-read)",
      "Bash(node --test:*)",
      "Bash(node --experimental-strip-types --test:*)",
      "Bash(node --experimental-vm-modules --experimental-strip-types --test:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./.local-data/**)"
    ]
  }
}
